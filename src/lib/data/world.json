  {"id": "world-026", "category": "Study", "level": 2, "hanzi": "我正在准备明天的课。", "pinyin": ["wo3", "zheng4", "zai4", "zhun3", "bei4", "ming2", "tian1", "de5", "ke4"], "english": "I am preparing tomorrow's lesson."},
  {"id": "world-027", "category": "Study", "level": 2, "hanzi": "同学们都到齐了。", "pinyin": ["tong2", "xue2", "men5", "dou1", "dao4", "qi2", "le5"], "english": "All the students have arrived."},
  {"id": "world-028", "category": "Study", "level": 2, "hanzi": "下课以后我们去吃饭。", "pinyin": ["xia4", "ke4", "yi3", "hou4", "wo3", "men5", "qu4", "chi1", "fan4"], "english": "We'll go eat after class."},
  {"id": "world-029", "category": "Study", "level": 3, "hanzi": "先复习旧字，再学习新字。", "pinyin": ["xian1", "fu4", "xi2", "jiu4", "zi4", "zai4", "xue2", "xi2", "xin1", "zi4"], "english": "Review old characters first, then learn new ones."},
  {"id": "world-030", "category": "Study", "level": 3, "hanzi": "遇到不懂的地方就问老师。", "pinyin": ["yu4", "dao4", "bu4", "dong3", "de5", "di4", "fang5", "jiu4", "wen4", "lao3", "shi1"], "english": "Ask the teacher whenever you don't understand something."},
  {"id": "world-031", "category": "Study", "level": 3, "hanzi": "这个方法对我很有帮助。", "pinyin": ["zhe4", "ge5", "fang1", "fa3", "dui4", "wo3", "hen3", "you3", "bang1", "zhu4"], "english": "This method is very helpful for me."},
  {"id": "world-032", "category": "Study", "level": 3, "hanzi": "我们需要在周五之前完成。", "pinyin": ["wo3", "men5", "xu1", "yao4", "zai4", "zhou1", "wu3", "zhi1", "qian2", "wan2", "cheng2"], "english": "We need to finish before Friday."},
  {"id": "world-033", "category": "Study", "level": 3, "hanzi": "休息一会儿再继续工作。", "pinyin": ["xiu1", "xi5", "yi1", "hui4", "er5", "zai4", "ji4", "xu4", "gong1", "zuo4"], "english": "Take a short break, then keep working."},
  {"id": "world-034", "category": "Study", "level": 3, "hanzi": "虽然很忙，我还是每天读书。", "pinyin": ["sui1", "ran2", "hen3", "mang2", "wo3", "hai2", "shi4", "mei3", "tian1", "du2", "shu1"], "english": "Even though I'm busy, I still read every day."},
  {"id": "world-035", "category": "People", "level": 1, "hanzi": "我的家人都很好。", "pinyin": ["wo3", "de5", "jia1", "ren2", "dou1", "hen3", "hao3"], "english": "Everyone in my family is doing well."},
  {"id": "world-036", "category": "People", "level": 1, "hanzi": "妈妈正在做晚饭。", "pinyin": ["ma1", "ma5", "zheng4", "zai4", "zuo4", "wan3", "fan4"], "english": "Mom is making dinner."},
  {"id": "world-037", "category": "People", "level": 1, "hanzi": "爸爸今天回来很早。", "pinyin": ["ba4", "ba5", "jin1", "tian1", "hui2", "lai2", "hen3", "zao3"], "english": "Dad came home early today."},
  {"id": "world-038", "category": "People", "level": 1, "hanzi": "妹妹喜欢小猫。", "pinyin": ["mei4", "mei5", "xi3", "huan5", "xiao3", "mao1"], "english": "My younger sister likes kittens."},
  {"id": "world-039", "category": "People", "level": 1, "hanzi": "哥哥比我高一点。", "pinyin": ["ge1", "ge5", "bi3", "wo3", "gao1", "yi1", "dian3"], "english": "My older brother is a little taller than me."},
  {"id": "world-040", "category": "People", "level": 1, "hanzi": "我有两个姐姐。", "pinyin": ["wo3", "you3", "liang3", "ge5", "jie3", "jie5"], "english": "I have two older sisters."},
  {"id": "world-041", "category": "People", "level": 1, "hanzi": "弟弟今年八岁。", "pinyin": ["di4", "di5", "jin1", "nian2", "ba1", "sui4"], "english": "My younger brother is eight this year."},
  {"id": "world-042", "category": "People", "level": 1, "hanzi": "这是我的好朋友。", "pinyin": ["zhe4", "shi4", "wo3", "de5", "hao3", "peng2", "you5"], "english": "This is my good friend."},
  {"id": "world-043", "category": "People", "level": 1, "hanzi": "我的朋友住在北京。", "pinyin": ["wo3", "de5", "peng2", "you5", "zhu4", "zai4", "bei3", "jing1"], "english": "My friend lives in Beijing."},
  {"id": "world-044", "category": "People", "level": 1, "hanzi": "你家有几口人？", "pinyin": ["ni3", "jia1", "you3", "ji3", "kou3", "ren2"], "english": "How many people are in your family?"},
  {"id": "world-045", "category": "People", "level": 1, "hanzi": "爷爷教我下中国象棋。", "pinyin": ["ye2", "ye5", "jiao1", "wo3", "xia4", "zhong1", "guo2", "xiang4", "qi2"], "english": "Grandpa teaches me to play Chinese chess."},
  {"id": "world-046", "category": "People", "level": 1, "hanzi": "奶奶喜欢喝热茶。", "pinyin": ["nai3", "nai5", "xi3", "huan5", "he1", "re4", "cha2"], "english": "Grandma likes drinking hot tea."},
  {"id": "world-047", "category": "People", "level": 1, "hanzi": "孩子们在院子里玩。", "pinyin": ["hai2", "zi5", "men5", "zai4", "yuan4", "zi5", "li3", "wan2"], "english": "The children are playing in the yard."},
  {"id": "world-048", "category": "People", "level": 1, "hanzi": "她是我们的邻居。", "pinyin": ["ta1", "shi4", "wo3", "men5", "de5", "lin2", "ju1"], "english": "She is our neighbor."},
  {"id": "world-049", "category": "People", "level": 1, "hanzi": "我想给朋友打电话。", "pinyin": ["wo3", "xiang3", "gei3", "peng2", "you5", "da3", "dian4", "hua4"], "english": "I want to call my friend."},
  {"id": "world-050", "category": "People", "level": 2, "hanzi": "我们周末一起吃饭。", "pinyin": ["wo3", "men5", "zhou1", "mo4", "yi1", "qi3", "chi1", "fan4"], "english": "We eat together on weekends."},
  {"id": "world-051", "category": "People", "level": 2, "hanzi": "他总是愿意帮助别人。", "pinyin": ["ta1", "zong3", "shi4", "yuan4", "yi4", "bang1", "zhu4", "bie2", "ren5"], "english": "He is always willing to help others."},
  {"id": "world-052", "category": "People", "level": 2, "hanzi": "她笑起来很好看。", "pinyin": ["ta1", "xiao4", "qi3", "lai2", "hen3", "hao3", "kan4"], "english": "She has a lovely smile."},
  {"id": "world-053", "category": "People", "level": 2, "hanzi": "我和姐姐长得很像。", "pinyin": ["wo3", "he2", "jie3", "jie5", "zhang3", "de5", "hen3", "xiang4"], "english": "My older sister and I look very alike."},
  {"id": "world-054", "category": "People", "level": 2, "hanzi": "叔叔送了我一本书。", "pinyin": ["shu1", "shu5", "song4", "le5", "wo3", "yi1", "ben3", "shu1"], "english": "My uncle gave me a book."},
  {"id": "world-055", "category": "People", "level": 2, "hanzi": "阿姨做的面条很好吃。", "pinyin": ["a1", "yi2", "zuo4", "de5", "mian4", "tiao2", "hen3", "hao3", "chi1"], "english": "The noodles my aunt makes are delicious."},
  {"id": "world-056", "category": "People", "level": 2, "hanzi": "今天是妈妈的生日。", "pinyin": ["jin1", "tian1", "shi4", "ma1", "ma5", "de5", "sheng1", "ri4"], "english": "Today is Mom's birthday."},
  {"id": "world-057", "category": "People", "level": 2, "hanzi": "我给爸爸买了一件衣服。", "pinyin": ["wo3", "gei3", "ba4", "ba5", "mai3", "le5", "yi1", "jian4", "yi1", "fu5"], "english": "I bought Dad an item of clothing."},
  {"id": "world-058", "category": "People", "level": 2, "hanzi": "他们住在同一条街上。", "pinyin": ["ta1", "men5", "zhu4", "zai4", "tong2", "yi1", "tiao2", "jie1", "shang4"], "english": "They live on the same street."},
  {"id": "world-059", "category": "People", "level": 2, "hanzi": "朋友之间应该互相理解。", "pinyin": ["peng2", "you5", "zhi1", "jian1", "ying1", "gai1", "hu4", "xiang1", "li3", "jie3"], "english": "Friends should try to understand each other."},
  {"id": "world-060", "category": "People", "level": 2, "hanzi": "你可以介绍一下自己吗？", "pinyin": ["ni3", "ke3", "yi3", "jie4", "shao4", "yi1", "xia4", "zi4", "ji3", "ma5"], "english": "Could you introduce yourself?"},
  {"id": "world-061", "category": "People", "level": 2, "hanzi": "我很久没有见到他了。", "pinyin": ["wo3", "hen3", "jiu3", "mei2", "you3", "jian4", "dao4", "ta1", "le5"], "english": "I haven't seen him for a long time."},
  {"id": "world-062", "category": "People", "level": 2, "hanzi": "我们从小就是朋友。", "pinyin": ["wo3", "men5", "cong2", "xiao3", "jiu4", "shi4", "peng2", "you5"], "english": "We have been friends since childhood."},
  {"id": "world-063", "category": "People", "level": 3, "hanzi": "家人在一起就是幸福。", "pinyin": ["jia1", "ren2", "zai4", "yi1", "qi3", "jiu4", "shi4", "xing4", "fu2"], "english": "Being together with family is happiness."},
  {"id": "world-064", "category": "People", "level": 3, "hanzi": "不管多忙，都要关心家人。", "pinyin": ["bu4", "guan3", "duo1", "mang2", "dou1", "yao4", "guan1", "xin1", "jia1", "ren2"], "english": "No matter how busy you are, make time to care for your family."},
  {"id": "world-065", "category": "People", "level": 3, "hanzi": "她记得每个朋友的生日。", "pinyin": ["ta1", "ji4", "de5", "mei3", "ge5", "peng2", "you5", "de5", "sheng1", "ri4"], "english": "She remembers every friend's birthday."},
  {"id": "world-066", "category": "People", "level": 3, "hanzi": "谢谢你一直陪在我身边。", "pinyin": ["xie4", "xie5", "ni3", "yi1", "zhi2", "pei2", "zai4", "wo3", "shen1", "bian1"], "english": "Thank you for always being by my side."},
  {"id": "world-067", "category": "People", "level": 3, "hanzi": "认识你以后，我学会了很多。", "pinyin": ["ren4", "shi5", "ni3", "yi3", "hou4", "wo3", "xue2", "hui4", "le5", "hen3", "duo1"], "english": "I've learned a lot since getting to know you."},
  {"id": "world-068", "category": "People", "level": 3, "hanzi": "我们约好下个月再见面。", "pinyin": ["wo3", "men5", "yue1", "hao3", "xia4", "ge5", "yue4", "zai4", "jian4", "mian4"], "english": "We agreed to meet again next month."},
  {"id": "world-069", "category": "Feelings", "level": 1, "hanzi": "今天有很多开心的事。", "pinyin": ["jin1", "tian1", "you3", "hen3", "duo1", "kai1", "xin1", "de5", "shi4"], "english": "Many happy things happened today."},
  {"id": "world-070", "category": "Feelings", "level": 1, "hanzi": "你看起来有点累。", "pinyin": ["ni3", "kan4", "qi3", "lai2", "you3", "dian3", "lei4"], "english": "You look a little tired."},
  {"id": "world-071", "category": "Feelings", "level": 1, "hanzi": "我现在不想说话。", "pinyin": ["wo3", "xian4", "zai4", "bu4", "xiang3", "shuo1", "hua4"], "english": "I don't feel like talking right now."},
  {"id": "world-072", "category": "Feelings", "level": 1, "hanzi": "别担心，我没事。", "pinyin": ["bie2", "dan1", "xin1", "wo3", "mei2", "shi4"], "english": "Don't worry. I'm fine."},
  {"id": "world-073", "category": "Feelings", "level": 1, "hanzi": "我有一点紧张。", "pinyin": ["wo3", "you3", "yi1", "dian3", "jin3", "zhang1"], "english": "I'm a little nervous."},
  {"id": "world-074", "category": "Feelings", "level": 1, "hanzi": "听到这个消息我很高兴。", "pinyin": ["ting1", "dao4", "zhe4", "ge5", "xiao1", "xi5", "wo3", "hen3", "gao1", "xing4"], "english": "I'm happy to hear this news."},
  {"id": "world-075", "category": "Feelings", "level": 1, "hanzi": "我觉得这里很舒服。", "pinyin": ["wo3", "jue2", "de5", "zhe4", "li3", "hen3", "shu1", "fu5"], "english": "I feel very comfortable here."},
  {"id": "world-076", "category": "Feelings", "level": 1, "hanzi": "今天我特别想家。", "pinyin": ["jin1", "tian1", "wo3", "te4", "bie2", "xiang3", "jia1"], "english": "I'm especially homesick today."},
  {"id": "world-077", "category": "Feelings", "level": 1, "hanzi": "我不喜欢等太久。", "pinyin": ["wo3", "bu4", "xi3", "huan5", "deng3", "tai4", "jiu3"], "english": "I don't like waiting too long."},
  {"id": "world-078", "category": "Feelings", "level": 1, "hanzi": "你为什么不高兴？", "pinyin": ["ni3", "wei4", "shen2", "me5", "bu4", "gao1", "xing4"], "english": "Why are you unhappy?"},
  {"id": "world-079", "category": "Feelings", "level": 1, "hanzi": "和朋友在一起很快乐。", "pinyin": ["he2", "peng2", "you5", "zai4", "yi1", "qi3", "hen3", "kuai4", "le4"], "english": "Being with friends makes me happy."},
  {"id": "world-080", "category": "Feelings", "level": 1, "hanzi": "我已经好多了。", "pinyin": ["wo3", "yi3", "jing1", "hao3", "duo1", "le5"], "english": "I'm feeling much better now."},
  {"id": "world-081", "category": "Feelings", "level": 1, "hanzi": "这个故事让我想哭。", "pinyin": ["zhe4", "ge5", "gu4", "shi5", "rang4", "wo3", "xiang3", "ku1"], "english": "This story makes me want to cry."},
  {"id": "world-082", "category": "Feelings", "level": 1, "hanzi": "我对自己很满意。", "pinyin": ["wo3", "dui4", "zi4", "ji3", "hen3", "man3", "yi4"], "english": "I'm very pleased with myself."},
  {"id": "world-083", "category": "Feelings", "level": 2, "hanzi": "今天的心情像阳光一样好。", "pinyin": ["jin1", "tian1", "de5", "xin1", "qing2", "xiang4", "yang2", "guang1", "yi1", "yang4", "hao3"], "english": "My mood is as bright as the sunshine today."},
  {"id": "world-084", "category": "Feelings", "level": 2, "hanzi": "深呼吸，让自己放松。", "pinyin": ["shen1", "hu1", "xi1", "rang4", "zi4", "ji3", "fang4", "song1"], "english": "Take a deep breath and relax."},
  {"id": "world-085", "category": "Feelings", "level": 2, "hanzi": "我为你感到骄傲。", "pinyin": ["wo3", "wei4", "ni3", "gan3", "dao4", "jiao1", "ao4"], "english": "I'm proud of you."},
  {"id": "world-086", "category": "Feelings", "level": 2, "hanzi": "失败一次没有关系。", "pinyin": ["shi1", "bai4", "yi1", "ci4", "mei2", "you3", "guan1", "xi5"], "english": "It's okay to fail once."},
  {"id": "world-087", "category": "Feelings", "level": 2, "hanzi": "我有信心做好这件事。", "pinyin": ["wo3", "you3", "xin4", "xin1", "zuo4", "hao3", "zhe4", "jian4", "shi4"], "english": "I'm confident I can do this well."},
  {"id": "world-088", "category": "Feelings", "level": 2, "hanzi": "他的话让我很感动。", "pinyin": ["ta1", "de5", "hua4", "rang4", "wo3", "hen3", "gan3", "dong4"], "english": "What he said really moved me."},
  {"id": "world-089", "category": "Feelings", "level": 2, "hanzi": "请不要对自己太严格。", "pinyin": ["qing3", "bu4", "yao4", "dui4", "zi4", "ji3", "tai4", "yan2", "ge2"], "english": "Please don't be too hard on yourself."},
  {"id": "world-090", "category": "Feelings", "level": 2, "hanzi": "我终于可以放心了。", "pinyin": ["wo3", "zhong1", "yu2", "ke3", "yi3", "fang4", "xin1", "le5"], "english": "I can finally stop worrying."},
  {"id": "world-091", "category": "Feelings", "level": 2, "hanzi": "有时候我也会觉得孤单。", "pinyin": ["you3", "shi2", "hou5", "wo3", "ye3", "hui4", "jue2", "de5", "gu1", "dan1"], "english": "Sometimes I feel lonely too."},
  {"id": "world-092", "category": "Feelings", "level": 2, "hanzi": "和你聊天让我很放松。", "pinyin": ["he2", "ni3", "liao2", "tian1", "rang4", "wo3", "hen3", "fang4", "song1"], "english": "Talking with you helps me relax."},
  {"id": "world-093", "category": "Feelings", "level": 2, "hanzi": "这件小事让我开心了一天。", "pinyin": ["zhe4", "jian4", "xiao3", "shi4", "rang4", "wo3", "kai1", "xin1", "le5", "yi1", "tian1"], "english": "This little thing made me happy all day."},
  {"id": "world-094", "category": "Feelings", "level": 2, "hanzi": "累的时候就好好休息。", "pinyin": ["lei4", "de5", "shi2", "hou5", "jiu4", "hao3", "hao3", "xiu1", "xi5"], "english": "Rest well when you're tired."},
  {"id": "world-095", "category": "Feelings", "level": 2, "hanzi": "我很期待明天的旅行。", "pinyin": ["wo3", "hen3", "qi1", "dai4", "ming2", "tian1", "de5", "lv3", "xing2"], "english": "I'm really looking forward to tomorrow's trip."},
  {"id": "world-096", "category": "Feelings", "level": 3, "hanzi": "每一次进步都值得庆祝。", "pinyin": ["mei3", "yi1", "ci4", "jin4", "bu4", "dou1", "zhi2", "de5", "qing4", "zhu4"], "english": "Every bit of progress is worth celebrating."},
  {"id": "world-097", "category": "Feelings", "level": 3, "hanzi": "慢慢来，你已经做得很好了。", "pinyin": ["man4", "man4", "lai2", "ni3", "yi3", "jing1", "zuo4", "de5", "hen3", "hao3", "le5"], "english": "Take your time. You're already doing very well."},
  {"id": "world-098", "category": "Feelings", "level": 3, "hanzi": "我希望明天能有一个好心情。", "pinyin": ["wo3", "xi1", "wang4", "ming2", "tian1", "neng2", "you3", "yi1", "ge5", "hao3", "xin1", "qing2"], "english": "I hope I'll be in a good mood tomorrow."},
  {"id": "world-099", "category": "Feelings", "level": 3, "hanzi": "难过的时候可以找我聊聊。", "pinyin": ["nan2", "guo4", "de5", "shi2", "hou5", "ke3", "yi3", "zhao3", "wo3", "liao2", "liao5"], "english": "You can come talk to me when you're feeling sad."},
  {"id": "world-100", "category": "Feelings", "level": 3, "hanzi": "不要因为一个错误就放弃。", "pinyin": ["bu4", "yao4", "yin1", "wei4", "yi1", "ge5", "cuo4", "wu4", "jiu4", "fang4", "qi4"], "english": "Don't give up because of one mistake."},
  {"id": "world-101", "category": "Feelings", "level": 3, "hanzi": "把烦恼写下来，心里会轻松些。", "pinyin": ["ba3", "fan2", "nao3", "xie3", "xia4", "lai2", "xin1", "li3", "hui4", "qing1", "song1", "xie1"], "english": "Writing down your worries can help you feel lighter."},
  {"id": "world-102", "category": "City", "level": 1, "hanzi": "地铁入口在桥的右边。", "pinyin": ["di4", "tie3", "ru4", "kou3", "zai4", "qiao2", "de5", "you4", "bian1"], "english": "The subway entrance is to the right of the bridge."},
