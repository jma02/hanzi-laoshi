  {"id": "world-006", "category": "Study", "level": 1, "hanzi": "我们一起做作业。", "pinyin": ["wo3", "men5", "yi1", "qi3", "zuo4", "zuo4", "ye4"], "english": "Let's do our homework together."},
  {"id": "world-007", "category": "Study", "level": 1, "hanzi": "你的笔在桌上。", "pinyin": ["ni3", "de5", "bi3", "zai4", "zhuo1", "shang4"], "english": "Your pen is on the desk."},
  {"id": "world-008", "category": "Study", "level": 1, "hanzi": "明天我们有考试。", "pinyin": ["ming2", "tian1", "wo3", "men5", "you3", "kao3", "shi4"], "english": "We have an exam tomorrow."},
  {"id": "world-009", "category": "Study", "level": 1, "hanzi": "请再读一遍。", "pinyin": ["qing3", "zai4", "du2", "yi1", "bian4"], "english": "Please read it one more time."},
  {"id": "world-010", "category": "Study", "level": 1, "hanzi": "请帮我读这一行。", "pinyin": ["qing3", "bang1", "wo3", "du2", "zhe4", "yi1", "hang2"], "english": "Please help me read this line."},
  {"id": "world-011", "category": "Study", "level": 1, "hanzi": "我把新字写在纸上。", "pinyin": ["wo3", "ba3", "xin1", "zi4", "xie3", "zai4", "zhi3", "shang4"], "english": "I write the new characters on paper."},
  {"id": "world-012", "category": "Study", "level": 1, "hanzi": "上课的时候请认真听。", "pinyin": ["shang4", "ke4", "de5", "shi2", "hou5", "qing3", "ren4", "zhen1", "ting1"], "english": "Please listen carefully during class."},
  {"id": "world-013", "category": "Study", "level": 1, "hanzi": "我的学校不太远。", "pinyin": ["wo3", "de5", "xue2", "xiao4", "bu4", "tai4", "yuan3"], "english": "My school isn't very far away."},
  {"id": "world-014", "category": "Study", "level": 1, "hanzi": "他在图书馆看书。", "pinyin": ["ta1", "zai4", "tu2", "shu1", "guan3", "kan4", "shu1"], "english": "He is reading in the library."},
  {"id": "world-015", "category": "Study", "level": 1, "hanzi": "我们九点开始上课。", "pinyin": ["wo3", "men5", "jiu3", "dian3", "kai1", "shi3", "shang4", "ke4"], "english": "We start class at nine."},
  {"id": "world-016", "category": "Study", "level": 2, "hanzi": "我把答案写错了。", "pinyin": ["wo3", "ba3", "da2", "an4", "xie3", "cuo4", "le5"], "english": "I wrote the wrong answer."},
  {"id": "world-017", "category": "Study", "level": 2, "hanzi": "这个问题有点难。", "pinyin": ["zhe4", "ge5", "wen4", "ti2", "you3", "dian3", "nan2"], "english": "This question is a little difficult."},
  {"id": "world-018", "category": "Study", "level": 2, "hanzi": "你可以慢一点说吗？", "pinyin": ["ni3", "ke3", "yi3", "man4", "yi1", "dian3", "shuo1", "ma5"], "english": "Could you speak a little more slowly?"},
  {"id": "world-019", "category": "Study", "level": 2, "hanzi": "每天练习就会进步。", "pinyin": ["mei3", "tian1", "lian4", "xi2", "jiu4", "hui4", "jin4", "bu4"], "english": "Practicing every day will help you improve."},
  {"id": "world-020", "category": "Study", "level": 2, "hanzi": "我喜欢安静的教室。", "pinyin": ["wo3", "xi3", "huan5", "an1", "jing4", "de5", "jiao4", "shi4"], "english": "I like quiet classrooms."},
  {"id": "world-021", "category": "Study", "level": 2, "hanzi": "她的中文越来越好。", "pinyin": ["ta1", "de5", "zhong1", "wen2", "yue4", "lai2", "yue4", "hao3"], "english": "Her Chinese is getting better and better."},
  {"id": "world-022", "category": "Study", "level": 2, "hanzi": "今天的会议已经结束。", "pinyin": ["jin1", "tian1", "de5", "hui4", "yi4", "yi3", "jing1", "jie2", "shu4"], "english": "Today's meeting has already ended."},
  {"id": "world-023", "category": "Study", "level": 2, "hanzi": "我下午要去办公室。", "pinyin": ["wo3", "xia4", "wu3", "yao4", "qu4", "ban4", "gong1", "shi4"], "english": "I need to go to the office this afternoon."},
  {"id": "world-024", "category": "Study", "level": 2, "hanzi": "这份工作需要耐心。", "pinyin": ["zhe4", "fen4", "gong1", "zuo4", "xu1", "yao4", "nai4", "xin1"], "english": "This job requires patience."},
