[
  {"id": "world-001", "category": "Study", "level": 1, "hanzi": "我每天学习中文。", "pinyin": ["wo3", "mei3", "tian1", "xue2", "xi2", "zhong1", "wen2"], "english": "I study Chinese every day."},
  {"id": "world-002", "category": "Study", "level": 1, "hanzi": "老师今天很高兴。", "pinyin": ["lao3", "shi1", "jin1", "tian1", "hen3", "gao1", "xing4"], "english": "The teacher is very happy today."},
  {"id": "world-003", "category": "Study", "level": 1, "hanzi": "这本书很好看。", "pinyin": ["zhe4", "ben3", "shu1", "hen3", "hao3", "kan4"], "english": "This book is very enjoyable."},
  {"id": "world-004", "category": "Study", "level": 1, "hanzi": "请把名字写在这里。", "pinyin": ["qing3", "ba3", "ming2", "zi5", "xie3", "zai4", "zhe4", "li3"], "english": "Please write your name here."},
