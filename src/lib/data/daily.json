  {"id": "daily-024", "category": "Greetings", "level": 1, "hanzi": "我想问你一个问题。", "pinyin": ["wo3", "xiang3", "wen4", "ni3", "yi1", "ge5", "wen4", "ti2"], "english": "I'd like to ask you a question."},
  {"id": "daily-025", "category": "Greetings", "level": 1, "hanzi": "我们一起学习吧。", "pinyin": ["wo3", "men5", "yi1", "qi3", "xue2", "xi2", "ba5"], "english": "Let's study together."},
  {"id": "daily-026", "category": "Greetings", "level": 1, "hanzi": "你的中文很好。", "pinyin": ["ni3", "de5", "zhong1", "wen2", "hen3", "hao3"], "english": "Your Chinese is very good."},
