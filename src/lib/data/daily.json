  {"id": "daily-016", "category": "Greetings", "level": 1, "hanzi": "我今天很开心。", "pinyin": ["wo3", "jin1", "tian1", "hen3", "kai1", "xin1"], "english": "I'm very happy today."},
  {"id": "daily-017", "category": "Greetings", "level": 1, "hanzi": "最近忙不忙？", "pinyin": ["zui4", "jin4", "mang2", "bu4", "mang2"], "english": "Have you been busy lately?"},
  {"id": "daily-018", "category": "Greetings", "level": 1, "hanzi": "我最近有点忙。", "pinyin": ["wo3", "zui4", "jin4", "you3", "dian3", "mang2"], "english": "I've been a little busy lately."},
  {"id": "daily-019", "category": "Greetings", "level": 1, "hanzi": "谢谢你的帮助。", "pinyin": ["xie4", "xie5", "ni3", "de5", "bang1", "zhu4"], "english": "Thank you for your help."},
