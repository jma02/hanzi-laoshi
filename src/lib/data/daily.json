[
  {"id": "daily-001", "category": "Greetings", "level": 1, "hanzi": "你好，我是小王。", "pinyin": ["ni3", "hao3", "wo3", "shi4", "xiao3", "wang2"], "english": "Hello, I'm Xiao Wang."},
