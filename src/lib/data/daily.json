  {"id": "daily-028", "category": "Greetings", "level": 1, "hanzi": "我还在慢慢学。", "pinyin": ["wo3", "hai2", "zai4", "man4", "man4", "xue2"], "english": "I'm still learning, little by little."},
  {"id": "daily-029", "category": "Greetings", "level": 1, "hanzi": "这是我的朋友。", "pinyin": ["zhe4", "shi4", "wo3", "de5", "peng2", "you5"], "english": "This is my friend."},
  {"id": "daily-030", "category": "Greetings", "level": 1, "hanzi": "我们是同学。", "pinyin": ["wo3", "men5", "shi4", "tong2", "xue2"], "english": "We're classmates."},
  {"id": "daily-031", "category": "Greetings", "level": 1, "hanzi": "她是我的老师。", "pinyin": ["ta1", "shi4", "wo3", "de5", "lao3", "shi1"], "english": "She's my teacher."},
  {"id": "daily-032", "category": "Greetings", "level": 1, "hanzi": "欢迎来我家。", "pinyin": ["huan1", "ying2", "lai2", "wo3", "jia1"], "english": "Welcome to my home."},
  {"id": "daily-033", "category": "Greetings", "level": 1, "hanzi": "请坐，喝点茶吧。", "pinyin": ["qing3", "zuo4", "he1", "dian3", "cha2", "ba5"], "english": "Please sit down and have some tea."},
  {"id": "daily-034", "category": "Greetings", "level": 1, "hanzi": "见到你真好。", "pinyin": ["jian4", "dao4", "ni3", "zhen1", "hao3"], "english": "It's really good to see you."},
  {"id": "daily-035", "category": "Greetings", "level": 1, "hanzi": "祝你生日快乐。", "pinyin": ["zhu4", "ni3", "sheng1", "ri4", "kuai4", "le4"], "english": "Happy birthday to you."},
  {"id": "daily-036", "category": "Greetings", "level": 1, "hanzi": "祝你一路平安。", "pinyin": ["zhu4", "ni3", "yi1", "lu4", "ping2", "an1"], "english": "Have a safe journey."},
  {"id": "daily-037", "category": "Greetings", "level": 1, "hanzi": "我们明天见吧。", "pinyin": ["wo3", "men5", "ming2", "tian1", "jian4", "ba5"], "english": "Let's see each other tomorrow."},
  {"id": "daily-038", "category": "Greetings", "level": 1, "hanzi": "路上小心一点。", "pinyin": ["lu4", "shang5", "xiao3", "xin1", "yi1", "dian3"], "english": "Take care on your way."},
